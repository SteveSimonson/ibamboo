{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ibamboo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Custom domains become the origin (GHL A/CNAME records removed first).
  "workers_dev": true,
  "routes": [
    { "pattern": "ibamboo.com", "custom_domain": true },
    { "pattern": "www.ibamboo.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  // Cloudflare Email Sending (domain onboarded: ibamboo.com)
  // Enable: npx wrangler email sending enable ibamboo.com
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "hello@ibamboo.com",
        "vibe@ibamboo.com",
        "noreply@ibamboo.com"
      ]
    }
  ],
  "vars": {
    "EMAIL_FROM": "hello@ibamboo.com",
    "EMAIL_FROM_NAME": "iBamboo",
    "EMAIL_REPLY_TO": "hello@ibamboo.com"
  }
  // Secrets (set via CLI, never commit):
  //   npx wrangler secret put GHL_PIT
  //   npx wrangler secret put GHL_LOCATION_ID
}
